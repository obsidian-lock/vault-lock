#!/usr/bin/env python3
"""vlb: pairing and computer admin for the Vault Lock server.

How pairing works: on first start the plugin makes up its own random key and drops a small
request (its id, computer name and a bcrypt hash of the key) into the inbox through the
public "pair" login, which can only create files. `vlb process` (run every 15 s by
vlb-pair.timer) accepts EVERY valid request: each computer gets its own WebDAV login and
its own sealed folder. Pairing is an open door, so your own computer can never be blocked
by someone else pairing first. A computer only ever sees its own folder, so a stranger who
installs the plugin gets an empty sandbox, never your notes.

Strangers are kept cheap. A computer you haven't marked with `vlb mine` is frozen
(read-only) when its folder grows past a cap, when all strangers together grow past a cap,
or when the disk runs low. Once one computer is marked yours, the strangers' folders are
left out of the nightly snapshot (snapshot-exclude.txt). When all slots are taken, the
oldest stranger is retired (login revoked, folder kept) so your own computer always gets in.

Layout under ROOT (/opt/obsidian-webdav):
  state.json                 source of truth: pairing state, computers, bans, extra users
  conf/webdav/config.json    generated for the obsidian-webdav container (never hand-edit)
  conf/pair/config.json      generated for the obsidian-pair container (the inbox)
  snapshot-exclude.txt       generated: strangers' folders, for tar --exclude-from
  inbox/                     pairing requests land here
  data/devices/<folder>/     one folder per paired computer: the vault, _manifest.json,
                             _trash/ and _control/
  vlb.log                    what vlb did

Commands:
  vlb status                 pairing state and every computer: size, last check-in, last
                             error (the plugin shows nothing on the computer itself)
  vlb mine COMPUTER          mark a computer as yours: never frozen, always in the snapshot
  vlb move COMPUTER FOLDER   that computer continues an existing folder (a new or
                             reinstalled laptop picks up an old backup); it pairs again
                             and gets the folder's files back before its first backup
  vlb remove COMPUTER        revoke a computer's login and refuse it from now on;
                             its folder is kept (vlb move lets it back in)
  vlb close                  pause: new computers wait (they keep asking every minute)
  vlb open [--only NAME]     resume; --only accepts just the computer with that name
  vlb process                handle the inbox and the caps (the timer runs this)
  vlb apply [--no-restart]   regenerate the configs from state.json and restart if changed

COMPUTER is a name (if unique), login, id or folder as shown by `vlb status`.
Caps (env overrides, for tests): VLB_MAX_DEVICES=100 VLB_DEVICE_MAX_MB=10240
VLB_OTHERS_MAX_MB=30720 VLB_DISK_MIN_FREE_MB=10240 VLB_CHECK_MINUTES=1
"""

import datetime
import fcntl
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import time

ROOT = os.environ.get("VLB_ROOT", "/opt/obsidian-webdav")
STATE = os.path.join(ROOT, "state.json")
INBOX = os.path.join(ROOT, "inbox")
DEVICES = os.path.join(ROOT, "data", "devices")
CONF = {"webdav": os.path.join(ROOT, "conf", "webdav", "config.json"),
        "pair": os.path.join(ROOT, "conf", "pair", "config.json")}
CONTAINER = {"webdav": "obsidian-webdav", "pair": "obsidian-pair"}
EXCLUDE = os.path.join(ROOT, "snapshot-exclude.txt")
LOG = os.path.join(ROOT, "vlb.log")
LOCK = os.path.join(ROOT, ".vlb.lock")

# Public on purpose: this login can only create small files in the inbox, and only while
# pairing is open. It must match PAIR_PASSWORD in the plugin's src/server.ts.
PAIR_USER = "pair"
PAIR_PASSWORD = "vault-lock-backup-pairing"

MB = 1024 * 1024
MAX_DEVICES = int(os.environ.get("VLB_MAX_DEVICES", "100"))
DEVICE_MAX = int(os.environ.get("VLB_DEVICE_MAX_MB", "10240")) * MB
OTHERS_MAX = int(os.environ.get("VLB_OTHERS_MAX_MB", "30720")) * MB
DISK_MIN_FREE = int(os.environ.get("VLB_DISK_MIN_FREE_MB", "10240")) * MB
CHECK_SECONDS = float(os.environ.get("VLB_CHECK_MINUTES", "1")) * 60

ID_RE = re.compile(r"^[a-f0-9]{16}$")
HASH_RE = re.compile(r"^\$2[aby]\$\d\d\$[./A-Za-z0-9]{53}$")
FOLDER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
MAX_REQUEST = 4096


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def log(msg):
    line = f"{now()} {msg}"
    print(line)
    with open(LOG, "a") as f:
        f.write(line + "\n")


def clean(value, limit=32, fallback=""):
    s = re.sub(r"[^A-Za-z0-9-]", "", str(value or ""))[:limit]
    return s or fallback


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024


def write_text(path, text, mode=0o600):
    """Atomic: a crash never leaves a half-written file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_json(path, value, mode=0o600):
    write_text(path, json.dumps(value, indent=2) + "\n", mode)


def read_json(path):
    """The JSON in a file, or None when it is missing or unreadable."""
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def load_state():
    state = {}
    if os.path.exists(STATE):
        with open(STATE) as f:
            state = json.load(f)
    state.setdefault("pairing", {"open": True, "since": now()})
    state["pairing"].setdefault("only", None)
    state["pairing"].pop("into", None)  # before open-door pairing
    for key, default in (("devices", []), ("extraUsers", []), ("banned", []), ("moves", {})):
        state.setdefault(key, default)
    for d in state["devices"]:
        d.setdefault("mine", False)
        d.setdefault("frozen", None)
    return state


def save_state(state):
    write_json(STATE, state)


# ---- configs ----------------------------------------------------------------------

def webdav_config(state):
    # Extra users may carry a "note" for humans; pass on only what hacdias knows.
    keep = ("username", "password", "directory", "permissions", "rules")
    users = [{k: u[k] for k in keep if k in u} for u in state["extraUsers"]]
    for d in state["devices"]:
        users.append({
            "username": d["username"],
            "password": "{bcrypt}" + d["hash"],
            "directory": "/data/devices/" + d["folder"],
            "permissions": "R" if d.get("frozen") else "CRUD",
        })
    if not users:
        # hacdias/webdav turns authentication OFF when no users are listed. Never allow that.
        if not state.get("lockedPassword"):
            state["lockedPassword"] = secrets.token_hex(32)
        users.append({"username": "locked", "password": state["lockedPassword"], "permissions": "none"})
    return {
        "address": "0.0.0.0", "port": 6065, "behindProxy": True,
        "directory": "/data/devices", "permissions": "none",
        "users": users,
    }


def pair_config(state):
    p = state["pairing"]
    if not p.get("closedPassword"):
        p["closedPassword"] = secrets.token_hex(32)
    password = PAIR_PASSWORD if p.get("open") else p["closedPassword"]
    return {
        "address": "0.0.0.0", "port": 6065, "behindProxy": True,
        "prefix": "/_pair/", "directory": "/inbox", "permissions": "none",
        "users": [{"username": PAIR_USER, "password": password, "permissions": "C"}],
    }


def snapshot_exclude(state):
    """Strangers' folders, one per line, for tar --exclude-from. Empty until a computer is
    marked yours, so the first nights are covered no matter what."""
    if not any(d.get("mine") for d in state["devices"]):
        return ""
    return "".join(f"data/devices/{d['folder']}\n" for d in state["devices"] if not d.get("mine"))


def restart_if_pending(key):
    """Restart a container whose written config differs from the one it was started with
    (<config>.applied). A restart that fails or hangs is simply tried again on the next run."""
    cfg, applied = read_json(CONF[key]), CONF[key] + ".applied"
    if cfg is None or read_json(applied) == cfg:
        return
    try:
        r = subprocess.run(["docker", "restart", CONTAINER[key]], capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"docker restart {CONTAINER[key]} timed out; retried on the next run")
    if r.returncode != 0:
        raise RuntimeError(f"docker restart {CONTAINER[key]} failed: {r.stderr.strip()}; retried on the next run")
    write_json(applied, cfg)
    log(f"restarted {CONTAINER[key]}")


def apply(state, restart=True):
    """Write the configs; restart a container only when its config changed."""
    wanted = {"webdav": webdav_config(state), "pair": pair_config(state)}
    save_state(state)  # the configs may have added generated passwords
    write_text(EXCLUDE, snapshot_exclude(state))
    for key, cfg in wanted.items():
        if read_json(CONF[key]) != cfg:
            write_json(CONF[key], cfg)
        if restart:
            restart_if_pending(key)


# ---- inbox ------------------------------------------------------------------------

def read_request(path):
    """A valid request, or None. Anything odd is ignored, never trusted."""
    try:
        if os.path.getsize(path) > MAX_REQUEST:
            return None
        with open(path) as f:
            req = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(req, dict):
        return None
    rid, h = req.get("id"), req.get("hash")
    if not isinstance(rid, str) or not ID_RE.match(rid) or os.path.basename(path) != rid + ".json":
        return None
    if not isinstance(h, str) or not HASH_RE.match(h):
        return None
    return {
        "id": rid, "hash": h,
        "name": clean(req.get("name"), 32, "computer"),
        "user": clean(req.get("user"), 32),
        "os": clean(req.get("os"), 16),
        "plugin": re.sub(r"[^0-9.]", "", str(req.get("plugin") or ""))[:16],
    }


def unique_folder(state, base):
    taken = {d["folder"] for d in state["devices"]}
    if os.path.isdir(DEVICES):
        taken |= set(os.listdir(DEVICES))
    folder, n = base, 2
    while folder in taken:
        folder, n = f"{base}-{n}", n + 1
    return folder


def accept(state, req):
    move = state["moves"].pop(req["id"], None)
    folder = move["folder"] if move else unique_folder(state, f"{req['name']}-{req['id'][:6]}")
    os.makedirs(os.path.join(DEVICES, folder), exist_ok=True)  # before the restart: hacdias probes it
    state["devices"].append({
        "id": req["id"], "username": "d-" + req["id"], "hash": req["hash"],
        "folder": folder, "name": req["name"], "user": req["user"], "os": req["os"],
        "plugin": req["plugin"], "pairedAt": now(),
        "mine": bool(move and move.get("mine")), "frozen": None,
    })
    log(f"paired {req['name']} (user {req['user'] or '?'}, {req['os'] or '?'}) "
        f"as d-{req['id']} -> data/devices/{folder}" + (" (continued)" if move else ""))


def retire_stranger(state):
    """Make room for one more: revoke the oldest stranger (a frozen one first). Its folder is
    kept if it holds anything, and its id is refused from now on, so it cannot push the next
    one out by simply pairing again. Returns False when there is no stranger to retire."""
    others = [d for d in state["devices"] if not d.get("mine")]
    if not others:
        return False
    d = min(others, key=lambda d: (not d.get("frozen"), d.get("pairedAt", "")))
    state["devices"].remove(d)
    if d["id"] not in state["banned"]:
        state["banned"].append(d["id"])
    try:
        os.rmdir(os.path.join(DEVICES, d["folder"]))  # only when empty; data is never deleted
    except OSError:
        pass
    log(f"full: retired the oldest stranger {d['name']} ({d['username']}); folder data/devices/{d['folder']} kept if not empty")
    return True


def process(state):
    before = json.dumps(state, sort_keys=True)
    changed = guards(state)
    files, junk = [], []
    if os.path.isdir(INBOX):
        for n in os.listdir(INBOX):
            f = os.path.join(INBOX, n)
            (files if os.path.isfile(f) and not os.path.islink(f) else junk).append(f)
        files.sort(key=lambda f: os.path.getmtime(f))
    for f in junk:  # folders and the like: Caddy only lets a PUT of <id>.json through, but never trust that alone
        try:
            if os.path.isdir(f) and not os.path.islink(f):
                shutil.rmtree(f, ignore_errors=True)
            else:
                os.remove(f)
        except OSError:
            pass
    if junk:
        log(f"removed {len(junk)} stray inbox entries")
    p = state["pairing"]
    if files and not p.get("open"):
        log(f"pairing paused: dropped {len(files)} request(s)")
    elif files:
        paired = {d["id"] for d in state["devices"]}
        banned = set(state["banned"])
        refused = invalid = 0
        for f in files:
            req = read_request(f)
            if req is None:
                invalid += 1
                continue
            if req["id"] in paired or req["id"] in banned:
                continue  # already in (asked again after a hiccup), or removed for good
            moving = req["id"] in state["moves"]
            wanted = bool(p.get("only")) and req["name"] == p["only"]
            if p.get("only") and not wanted and not moving:
                continue
            strangers = [d for d in state["devices"] if not d.get("mine")]
            if len(strangers) >= MAX_DEVICES and not moving and not wanted and not retire_stranger(state):
                refused += 1
                continue
            accept(state, req)
            paired.add(req["id"])
            changed = True
        if invalid:
            log(f"ignored {invalid} invalid request(s)")
        if refused and time.time() - state.get("fullLoggedAt", 0) > 3600:
            state["fullLoggedAt"] = time.time()
            log(f"FULL: {MAX_DEVICES} strangers paired and none could be retired; refused {refused} request(s).")
    for f in files:
        if os.path.exists(f):
            os.remove(f)
    if changed:
        apply(state)
    else:
        if json.dumps(state, sort_keys=True) != before:
            save_state(state)
        for key in CONF:
            restart_if_pending(key)  # a restart that failed earlier


# ---- caps -------------------------------------------------------------------------

def folder_size(folder):
    path = os.path.join(DEVICES, folder)
    if not os.path.isdir(path):
        return 0
    r = subprocess.run(["du", "-sb", path], capture_output=True, text=True)
    try:
        return int(r.stdout.split()[0])
    except (ValueError, IndexError):
        return 0


def guards(state):
    """Keep strangers cheap: freeze (read-only) computers that aren't yours when they grow
    past the caps or the disk runs low. Returns True if a computer was frozen."""
    if time.time() - state.get("lastCheck", 0) < CHECK_SECONDS:
        return False
    state["lastCheck"] = time.time()
    others = [d for d in state["devices"] if not d.get("mine")]
    if not others:
        return False
    sizes = {d["id"]: folder_size(d["folder"]) for d in others}
    total = sum(sizes.values())
    free = shutil.disk_usage(ROOT).free
    everyone = None
    if total > OTHERS_MAX:
        everyone = f"all strangers together use {human(total)}, over the cap of {human(OTHERS_MAX)}"
    elif free < DISK_MIN_FREE:
        everyone = f"the disk has only {human(free)} free"
    froze = False
    for d in others:
        if d.get("frozen"):
            continue
        why = everyone
        if not why and sizes[d["id"]] > DEVICE_MAX:
            why = f"its folder uses {human(sizes[d['id']])}, over the cap of {human(DEVICE_MAX)}"
        if why:
            d["frozen"] = {"at": now(), "why": why}
            froze = True
            log(f"froze {d['name']} ({d['username']}): {why}. It can read but not write. "
                f"If it is yours: vlb mine {d['username']}")
    return froze


# ---- commands ---------------------------------------------------------------------

def find_device(state, key):
    for d in state["devices"]:
        if key in (d["id"], d["username"], d["folder"]):
            return d
    named = [d for d in state["devices"] if d["name"] == key]
    if len(named) == 1:
        return named[0]
    if len(named) > 1:
        sys.exit(f"{len(named)} computers are called {key!r}; use the login or folder. See: vlb status")
    return None


def device_id(key):
    """The id in a login/id, or None."""
    rid = key[2:] if key.startswith("d-") else key
    return rid if ID_RE.match(rid) else None


def last_seen(folder):
    """What the plugin last wrote to _control/status.json (after every backup and on a
    failure it could still report), or None if it never checked in."""
    try:
        with open(os.path.join(DEVICES, folder, "_control", "status.json")) as f:
            s = json.load(f)
        return s if isinstance(s, dict) else None
    except (OSError, ValueError):
        return None


def health_line(s):
    if not s:
        return "    never checked in: no backup yet (Obsidian not started, or the plugin can't reach the server)"
    line = f"    last check-in {s.get('at') or '?'}, plugin {s.get('version') or '?'}"
    if s.get("lastError"):
        line += f", ERROR: {s['lastError']} (the plugin retries every minute)"
    skipped = (s.get("lastReconcile") or {}).get("skipped") or []
    if skipped:
        line += f", {len(skipped)} file(s) over 100 MB skipped"
    return line


def cmd_status(state):
    p = state["pairing"]
    if p.get("open"):
        only = f", only a computer called {p['only']!r}" if p.get("only") else ""
        print(f"Pairing: OPEN since {p.get('since')}{only}. Every computer that asks gets its own sealed folder.")
    else:
        print(f"Pairing: PAUSED since {p.get('since')}. New computers wait. Resume with: vlb open")
    waiting = len(os.listdir(INBOX)) if os.path.isdir(INBOX) else 0
    if waiting:
        print(f"Inbox: {waiting} request(s) waiting for the next run")
    for rid, m in state["moves"].items():
        print(f"Waiting for d-{rid} to pair again into data/devices/{m['folder']}")
    n = len(state["devices"])
    if not n:
        print("No paired computers.")
    else:
        print(f"Computers: {n} of {MAX_DEVICES}" + ("  FULL: new ones are refused" if n >= MAX_DEVICES else ""))
    for d in state["devices"]:
        who = "YOURS" if d.get("mine") else "stranger"
        frozen = f"  FROZEN since {d['frozen']['at']}: {d['frozen']['why']}" if d.get("frozen") else ""
        print(f"- {who}: {d['name']} (user {d['user'] or '?'}, {d['os'] or '?'})  login {d['username']}{frozen}")
        print(f"    folder data/devices/{d['folder']} ({human(folder_size(d['folder']))})  paired {d['pairedAt']}")
        print(health_line(last_seen(d["folder"])))
    if state["banned"]:
        print(f"Removed for good: {len(state['banned'])} computer(s) (vlb move lets one back in)")
    for u in state["extraUsers"]:
        print(f"- extra login {u.get('username')} -> {u.get('directory', '/data/devices')}")
    if n and not any(d.get("mine") for d in state["devices"]):
        print("No computer is marked yours yet: caps apply to all, and all are in the snapshot. "
              "Find yours above (name and user) and run: vlb mine <name>")


def cmd_mine(state, key):
    d = find_device(state, key)
    if not d:
        sys.exit(f"No paired computer matches {key!r}. See: vlb status")
    d["mine"], d["frozen"] = True, None
    apply(state)
    log(f"{d['name']} ({d['username']}) is yours: no caps, always in the snapshot")


def cmd_move(state, key, folder):
    if not FOLDER_RE.match(folder) or not os.path.isdir(os.path.join(DEVICES, folder)):
        sys.exit(f"No folder data/devices/{folder}")
    d = find_device(state, key)
    rid = d["id"] if d else device_id(key)
    if not rid:
        sys.exit(f"No paired computer matches {key!r}. For a removed one give its login (d-...). See: vlb status")
    owner = next((o for o in state["devices"] if o["folder"] == folder), None)
    if owner and owner is not d:
        sys.exit(f"{owner['name']} ({owner['username']}) still uses that folder. "
                 f"If that computer is gone: vlb remove {owner['username']}")
    mine = bool(d and d.get("mine"))
    if d:
        state["devices"].remove(d)  # its login stops working; the plugin then asks to pair again
    if rid in state["banned"]:
        state["banned"].remove(rid)
    state["moves"][rid] = {"folder": folder, "mine": mine}
    # The folder's files go back to the computer first; otherwise its first backup would move
    # everything the computer does not have into the trash.
    cmds_path = os.path.join(DEVICES, folder, "_control", "commands.json")
    cmds = read_json(cmds_path)
    cmds = cmds if isinstance(cmds, list) else []
    cmds.append({"id": f"move-{rid}-{int(time.time())}", "cmd": "restore-all"})
    write_json(cmds_path, cmds, mode=0o644)
    apply(state)
    log(f"d-{rid} will continue data/devices/{folder}: it pairs again within a minute"
        + (f"; its folder data/devices/{d['folder']} is kept" if d and d["folder"] != folder else ""))
    if not state["pairing"].get("open"):
        print("Pairing is paused, so it waits until: vlb open")


def cmd_remove(state, key):
    d = find_device(state, key)
    if not d:
        sys.exit(f"No paired computer matches {key!r}. See: vlb status")
    state["devices"].remove(d)
    if d["id"] not in state["banned"]:
        state["banned"].append(d["id"])
    apply(state)
    log(f"removed {d['name']} ({d['username']}) for good; its folder data/devices/{d['folder']} is kept")


def cmd_open(state, only):
    state["pairing"].update({"open": True, "only": only, "since": now()})
    apply(state)
    log("pairing open" + (f", only for a computer called {only!r}" if only else ""))


def cmd_close(state):
    state["pairing"].update({"open": False, "only": None, "since": now()})
    apply(state)
    log("pairing paused by hand")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, args = argv[0], argv[1:]
    os.makedirs(ROOT, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_state()
        if cmd == "status" and not args:
            cmd_status(state)
        elif cmd == "mine" and len(args) == 1:
            cmd_mine(state, args[0])
        elif cmd == "move" and len(args) == 2:
            cmd_move(state, args[0], args[1])
        elif cmd == "remove" and len(args) == 1:
            cmd_remove(state, args[0])
        elif cmd == "open" and (not args or (args[0] == "--only" and len(args) == 2 and clean(args[1]))):
            cmd_open(state, clean(args[1]) if args else None)
        elif cmd == "close" and not args:
            cmd_close(state)
        elif cmd == "process" and not args:
            process(state)
        elif cmd == "apply" and args in ([], ["--no-restart"]):
            apply(state, restart=not args)
        else:
            sys.exit(f"Unknown command: {' '.join(argv)}. See: vlb help")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except SystemExit:
        raise
    except Exception as e:  # keep the timer's log readable
        log(f"ERROR {type(e).__name__}: {e}")
        sys.exit(1)
