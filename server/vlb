#!/usr/bin/env python3
"""vlb: pairing and computer admin for the Vault Lock server.

How pairing works: on first start the plugin makes up its own random key and drops a small
request (its id, computer name and a bcrypt hash of the key) into the inbox through the
public "pair" login, which can only create files. `vlb process` (run every 15 s by
vlb-pair.timer) accepts EVERY valid request: each computer gets its own WebDAV login and
its own sealed folder. Pairing is an open door, so your own computer can never be blocked
by someone else pairing first. A computer only ever sees its own folder, so a stranger who
installs the plugin gets an empty sandbox, never your notes.

Strangers are kept cheap. A computer you haven't marked with `vlb mine` is frozen
(read-only) when its folder grows past a cap, when all strangers together grow past a cap,
or when the disk runs low. Once one computer is marked yours, the strangers' folders are
left out of the nightly snapshot (snapshot-exclude.txt). When all slots are taken, the
oldest stranger is retired (login revoked, folder kept) so your own computer always gets in.

Layout under ROOT (/opt/obsidian-webdav):
  state.json                 source of truth: pairing state, computers, bans, extra users
  conf/webdav/config.json    generated for the obsidian-webdav container (never hand-edit)
  conf/pair/config.json      generated for the obsidian-pair container (the inbox)
  snapshot-exclude.txt       generated: strangers' folders, for tar --exclude-from
  inbox/                     pairing requests land here
  data/devices/<folder>/     one folder per paired computer: the vault, _manifest.json,
                             _trash/ and _control/ (_control/update/app and /core hold the
                             signed plugin code published with vlb bundle)
  vlb.log                    what vlb did
Elsewhere:
  /root/.config/vault-lock/  the signing key (signing.pem, root only; never in the nightly
                             snapshot), signing.pub.pem and signing.spki.hex
  /root/vault-lock-bundles/  the bundle archive: one folder per version with app.js and/or
                             main.js, the signed manifests as published, meta.json

Commands:
  vlb status                 pairing state and every computer: name, user, the addresses
                             it connects from, size, last check-in, last error (the
                             plugin shows nothing on the computer itself)
  vlb mine COMPUTER          mark a computer as yours: never frozen, always in the snapshot
  vlb passphrase COMPUTER    show the copy of that computer's vault passphrase (for the day
                             it is forgotten). Every paired computer sends one after the
                             passphrase is set, changed or typed to unlock
  vlb move COMPUTER FOLDER   that computer continues an existing folder (a new or
                             reinstalled laptop picks up an old backup); it pairs again
                             and gets the folder's files back before its first backup
  vlb remove COMPUTER        revoke a computer's login and refuse it from now on;
                             its folder is kept (vlb move lets it back in)
  vlb close                  pause: new computers wait (they keep asking every minute)
  vlb open [--only NAME]     resume; --only accepts just the computer with that name
  vlb process                handle the inbox and the caps (the timer runs this)
  vlb apply [--no-restart]   regenerate the configs from state.json and restart if changed

Plugin code from the server (plugin 1.7.0 and later; BRAT stays the normal way to update).
Every bundle is signed with the key below and checked by the plugin before it runs; a bad
bundle only sends the plugin back to its own built-in code. None of these restart anything.
  vlb key init               make the signing key (once). Prints the public key that goes
                             into the plugin (UPDATE_PUBKEYS in src/shared/server.ts)
  vlb key show               print the public key and its fingerprint
  vlb bundle fetch V         download release V (app.js, main.js, manifest.json) from GitHub
                             into the archive
  vlb bundle publish FILE|V [--version V] [--force] [--core] [--only COMPUTER]...
                             [--note TEXT] [--unsafe-local]
                             sign plugin code and put it into the folders of your computers
                             (or --only those computers, yours or strangers). FILE needs
                             --version; V is a version in the archive. The plugin picks it up
                             within 10 minutes and runs it from the next lock, if it is newer
                             than its own built-in code or --force is given (a rollback).
                             --core: a main.js that replaces the plugin itself at the next
                             Obsidian start; only a main.js fetched from a release, unless
                             --unsafe-local
  vlb bundle unpublish [--core] [--only COMPUTER]...
                             take it back: the plugin returns to its built-in code at the
                             next lock (a core bundle already installed stays)
  vlb safemode on|off [--only COMPUTER]...
                             on: the plugin runs only its lifeboat (the lock and a simple
                             backup) from its next check (within 10 minutes); off: normal

COMPUTER is a name (if unique), login, id or folder as shown by `vlb status`. Without
--only, the bundle and safemode commands act on every computer marked yours.
Caps (env overrides, for tests): VLB_MAX_DEVICES=100 VLB_DEVICE_MAX_MB=10240
VLB_OTHERS_MAX_MB=30720 VLB_DISK_MIN_FREE_MB=10240 VLB_CHECK_MINUTES=1
Paths (env overrides, for tests): VLB_ROOT VLB_KEY_DIR VLB_ARCHIVE VLB_RELEASES
"""

import base64
import datetime
import fcntl
import hashlib
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = os.environ.get("VLB_ROOT", "/opt/obsidian-webdav")
STATE = os.path.join(ROOT, "state.json")
INBOX = os.path.join(ROOT, "inbox")
DEVICES = os.path.join(ROOT, "data", "devices")
CONF = {"webdav": os.path.join(ROOT, "conf", "webdav", "config.json"),
        "pair": os.path.join(ROOT, "conf", "pair", "config.json")}
CONTAINER = {"webdav": "obsidian-webdav", "pair": "obsidian-pair"}
EXCLUDE = os.path.join(ROOT, "snapshot-exclude.txt")
LOG = os.path.join(ROOT, "vlb.log")
LOCK = os.path.join(ROOT, ".vlb.lock")

# Public on purpose: this login can only create small files in the inbox, and only while
# pairing is open. It must match PAIR_PASSWORD in the plugin's src/server.ts.
PAIR_USER = "pair"
PAIR_PASSWORD = "vault-lock-backup-pairing"

MB = 1024 * 1024
MAX_DEVICES = int(os.environ.get("VLB_MAX_DEVICES", "100"))
DEVICE_MAX = int(os.environ.get("VLB_DEVICE_MAX_MB", "10240")) * MB
OTHERS_MAX = int(os.environ.get("VLB_OTHERS_MAX_MB", "30720")) * MB
DISK_MIN_FREE = int(os.environ.get("VLB_DISK_MIN_FREE_MB", "10240")) * MB
CHECK_SECONDS = float(os.environ.get("VLB_CHECK_MINUTES", "1")) * 60

# Signed plugin code. The private key lives outside ROOT, so it is never in the nightly
# snapshot. The env overrides are for the round-trip test.
KEY_DIR = os.environ.get("VLB_KEY_DIR", "/root/.config/vault-lock")
KEY = os.path.join(KEY_DIR, "signing.pem")
PUB = os.path.join(KEY_DIR, "signing.pub.pem")
SPKI = os.path.join(KEY_DIR, "signing.spki.hex")
ARCHIVE = os.environ.get("VLB_ARCHIVE", "/root/vault-lock-bundles")
RELEASES = os.environ.get("VLB_RELEASES", "https://github.com/obsidian-lock/vault-lock/releases/download")
MAX_BUNDLE = 2 * MB      # the plugin refuses a bigger app.js / main.js
MAX_PAYLOAD = 2048       # ... and a bigger signed payload
SPKI_PREFIX = "302a300506032b6570032100"  # DER header of every Ed25519 public key
SLOT_FILE = {"app": "app.js", "core": "main.js"}
VERSION_RE = re.compile(r"^\d+\.\d+\.\d+$")
TIME_FMT = "%Y-%m-%dT%H:%M:%SZ"

ID_RE = re.compile(r"^[a-f0-9]{16}$")
HASH_RE = re.compile(r"^\$2[aby]\$\d\d\$[./A-Za-z0-9]{53}$")
FOLDER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
MAX_REQUEST = 4096
MAX_IPS = 20  # addresses remembered per computer
# hacdias logs every authorized request: "<time> INFO user authorized {"remote_address": ..., "username": ...}"
AUTH_RE = re.compile(r"^(\S+)\s.*user authorized\s+(\{.*\})\s*$")


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime(TIME_FMT)


def log(msg):
    line = f"{now()} {msg}"
    print(line)
    with open(LOG, "a") as f:
        f.write(line + "\n")


def clean(value, limit=32, fallback=""):
    s = re.sub(r"[^A-Za-z0-9-]", "", str(value or ""))[:limit]
    return s or fallback


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024


def write_bytes(path, data, mode=0o600):
    """Atomic: a crash never leaves a half-written file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_text(path, text, mode=0o600):
    write_bytes(path, text.encode("utf-8"), mode)


def write_json(path, value, mode=0o600):
    write_text(path, json.dumps(value, indent=2) + "\n", mode)


def read_json(path):
    """The JSON in a file, or None when it is missing or unreadable."""
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def load_state():
    state = {}
    if os.path.exists(STATE):
        with open(STATE) as f:
            state = json.load(f)
    state.setdefault("pairing", {"open": True, "since": now()})
    state["pairing"].setdefault("only", None)
    state["pairing"].pop("into", None)  # before open-door pairing
    for key, default in (("devices", []), ("extraUsers", []), ("banned", []), ("moves", {})):
        state.setdefault(key, default)
    if not isinstance(state.get("bundles"), dict):
        state["bundles"] = {"app": None, "core": None}  # what was published to your computers
    for d in state["devices"]:
        d.setdefault("mine", False)
        d.setdefault("frozen", None)
    return state


def save_state(state):
    write_json(STATE, state)


# ---- configs ----------------------------------------------------------------------

def webdav_config(state):
    # Extra users may carry a "note" for humans; pass on only what hacdias knows.
    keep = ("username", "password", "directory", "permissions", "rules")
    users = [{k: u[k] for k in keep if k in u} for u in state["extraUsers"]]
    for d in state["devices"]:
        users.append({
            "username": d["username"],
            "password": "{bcrypt}" + d["hash"],
            "directory": "/data/devices/" + d["folder"],
            "permissions": "R" if d.get("frozen") else "CRUD",
        })
    if not users:
        # hacdias/webdav turns authentication OFF when no users are listed. Never allow that.
        if not state.get("lockedPassword"):
            state["lockedPassword"] = secrets.token_hex(32)
        users.append({"username": "locked", "password": state["lockedPassword"], "permissions": "none"})
    return {
        "address": "0.0.0.0", "port": 6065, "behindProxy": True,
        "directory": "/data/devices", "permissions": "none",
        "users": users,
    }


def pair_config(state):
    p = state["pairing"]
    if not p.get("closedPassword"):
        p["closedPassword"] = secrets.token_hex(32)
    password = PAIR_PASSWORD if p.get("open") else p["closedPassword"]
    return {
        "address": "0.0.0.0", "port": 6065, "behindProxy": True,
        "prefix": "/_pair/", "directory": "/inbox", "permissions": "none",
        "users": [{"username": PAIR_USER, "password": password, "permissions": "C"}],
    }


def snapshot_exclude(state):
    """Strangers' folders, one per line, for tar --exclude-from. Empty until a computer is
    marked yours, so the first nights are covered no matter what."""
    if not any(d.get("mine") for d in state["devices"]):
        return ""
    return "".join(f"data/devices/{d['folder']}\n" for d in state["devices"] if not d.get("mine"))


def restart_if_pending(key):
    """Restart a container whose written config differs from the one it was started with
    (<config>.applied). A restart that fails or hangs is simply tried again on the next run."""
    cfg, applied = read_json(CONF[key]), CONF[key] + ".applied"
    if cfg is None or read_json(applied) == cfg:
        return
    try:
        r = subprocess.run(["docker", "restart", CONTAINER[key]], capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"docker restart {CONTAINER[key]} timed out; retried on the next run")
    if r.returncode != 0:
        raise RuntimeError(f"docker restart {CONTAINER[key]} failed: {r.stderr.strip()}; retried on the next run")
    write_json(applied, cfg)
    log(f"restarted {CONTAINER[key]}")


def apply(state, restart=True):
    """Write the configs; restart a container only when its config changed."""
    wanted = {"webdav": webdav_config(state), "pair": pair_config(state)}
    save_state(state)  # the configs may have added generated passwords
    write_text(EXCLUDE, snapshot_exclude(state))
    for key, cfg in wanted.items():
        if read_json(CONF[key]) != cfg:
            write_json(CONF[key], cfg)
        if restart:
            restart_if_pending(key)


# ---- inbox ------------------------------------------------------------------------

def read_request(path):
    """A valid request, or None. Anything odd is ignored, never trusted."""
    try:
        if os.path.getsize(path) > MAX_REQUEST:
            return None
        with open(path) as f:
            req = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(req, dict):
        return None
    rid, h = req.get("id"), req.get("hash")
    if not isinstance(rid, str) or not ID_RE.match(rid) or os.path.basename(path) != rid + ".json":
        return None
    if not isinstance(h, str) or not HASH_RE.match(h):
        return None
    return {
        "id": rid, "hash": h,
        "name": clean(req.get("name"), 32, "computer"),
        "user": clean(req.get("user"), 32),
        "os": clean(req.get("os"), 16),
        "plugin": re.sub(r"[^0-9.]", "", str(req.get("plugin") or ""))[:16],
    }


def unique_folder(state, base):
    taken = {d["folder"] for d in state["devices"]}
    if os.path.isdir(DEVICES):
        taken |= set(os.listdir(DEVICES))
    folder, n = base, 2
    while folder in taken:
        folder, n = f"{base}-{n}", n + 1
    return folder


def passphrase_copy(folder):
    """The plugin's copy of the vault passphrase ({passphrase, at, computer}), or None."""
    c = read_json(os.path.join(DEVICES, folder, "_control", "passphrase.json"))
    return c if isinstance(c, dict) and isinstance(c.get("passphrase"), str) else None


def accept(state, req):
    move = state["moves"].pop(req["id"], None)
    folder = move["folder"] if move else unique_folder(state, f"{req['name']}-{req['id'][:6]}")
    os.makedirs(os.path.join(DEVICES, folder), exist_ok=True)  # before the restart: hacdias probes it
    state["devices"].append({
        "id": req["id"], "username": "d-" + req["id"], "hash": req["hash"],
        "folder": folder, "name": req["name"], "user": req["user"], "os": req["os"],
        "plugin": req["plugin"], "pairedAt": now(),
        "mine": bool(move and move.get("mine")), "frozen": None,
    })
    log(f"paired {req['name']} (user {req['user'] or '?'}, {req['os'] or '?'}) "
        f"as d-{req['id']} -> data/devices/{folder}" + (" (continued)" if move else ""))


def retire_stranger(state):
    """Make room for one more: revoke the oldest stranger (a frozen one first). Its folder is
    kept if it holds anything, and its id is refused from now on, so it cannot push the next
    one out by simply pairing again. Returns False when there is no stranger to retire."""
    others = [d for d in state["devices"] if not d.get("mine")]
    if not others:
        return False
    d = min(others, key=lambda d: (not d.get("frozen"), d.get("pairedAt", "")))
    state["devices"].remove(d)
    if d["id"] not in state["banned"]:
        state["banned"].append(d["id"])
    try:
        os.rmdir(os.path.join(DEVICES, d["folder"]))  # only when empty; data is never deleted
    except OSError:
        pass
    log(f"full: retired the oldest stranger {d['name']} ({d['username']}); folder data/devices/{d['folder']} kept if not empty")
    return True


def strip_port(addr):
    m = re.match(r"^\[?([0-9a-fA-F.:]+?)\]?:\d+$", addr or "")
    return m.group(1) if m and ("." in m.group(1) or "]" in addr) else (addr or "")


def track_ips(state):
    """Remember from which addresses each computer talks to the server. The webdav container
    logs every authorized request with the client address (the real one; Caddy forwards it)
    and the login. This reads the lines written since the last run and keeps, per computer
    and address, the first and last time and a request count. Container logs rotate
    (docker-compose.yml); what is kept here in state.json does not."""
    since = state.get("ipsSeenUntil")
    cmd = ["docker", "logs", CONTAINER["webdav"]] + (["--since", since] if since else [])
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return
    by_login = {d["username"]: d for d in state["devices"]}
    newest = since or ""
    for line in (r.stdout + r.stderr).splitlines():
        m = AUTH_RE.match(line)
        if not m or m.group(1) <= (since or ""):
            continue
        ts = m.group(1)
        newest = max(newest, ts)
        try:
            info = json.loads(m.group(2))
        except ValueError:
            continue
        d = by_login.get(info.get("username"))
        ip = strip_port(str(info.get("remote_address") or ""))
        if d is None or not ip:
            continue
        ips = d.setdefault("ips", {})
        e = ips.get(ip)
        if e:
            e["last"], e["n"] = ts, e.get("n", 0) + 1
        else:
            ips[ip] = {"first": ts, "last": ts, "n": 1}
        while len(ips) > MAX_IPS:
            del ips[min(ips, key=lambda k: ips[k]["last"])]
    if newest != (since or ""):
        state["ipsSeenUntil"] = newest


def process(state):
    before = json.dumps(state, sort_keys=True)
    changed = guards(state)
    track_ips(state)
    files, junk = [], []
    if os.path.isdir(INBOX):
        for n in os.listdir(INBOX):
            f = os.path.join(INBOX, n)
            (files if os.path.isfile(f) and not os.path.islink(f) else junk).append(f)
        files.sort(key=lambda f: os.path.getmtime(f))
    for f in junk:  # folders and the like: Caddy only lets a PUT of <id>.json through, but never trust that alone
        try:
            if os.path.isdir(f) and not os.path.islink(f):
                shutil.rmtree(f, ignore_errors=True)
            else:
                os.remove(f)
        except OSError:
            pass
    if junk:
        log(f"removed {len(junk)} stray inbox entries")
    p = state["pairing"]
    if files and not p.get("open"):
        log(f"pairing paused: dropped {len(files)} request(s)")
    elif files:
        paired = {d["id"] for d in state["devices"]}
        banned = set(state["banned"])
        refused = invalid = 0
        for f in files:
            req = read_request(f)
            if req is None:
                invalid += 1
                continue
            if req["id"] in paired or req["id"] in banned:
                continue  # already in (asked again after a hiccup), or removed for good
            moving = req["id"] in state["moves"]
            wanted = bool(p.get("only")) and req["name"] == p["only"]
            if p.get("only") and not wanted and not moving:
                continue
            strangers = [d for d in state["devices"] if not d.get("mine")]
            if len(strangers) >= MAX_DEVICES and not moving and not wanted and not retire_stranger(state):
                refused += 1
                continue
            accept(state, req)
            paired.add(req["id"])
            changed = True
        if invalid:
            log(f"ignored {invalid} invalid request(s)")
        if refused and time.time() - state.get("fullLoggedAt", 0) > 3600:
            state["fullLoggedAt"] = time.time()
            log(f"FULL: {MAX_DEVICES} strangers paired and none could be retired; refused {refused} request(s).")
    for f in files:
        if os.path.exists(f):
            os.remove(f)
    if changed:
        apply(state)
    else:
        if json.dumps(state, sort_keys=True) != before:
            save_state(state)
        for key in CONF:
            restart_if_pending(key)  # a restart that failed earlier


# ---- caps -------------------------------------------------------------------------

def folder_size(folder):
    path = os.path.join(DEVICES, folder)
    if not os.path.isdir(path):
        return 0
    r = subprocess.run(["du", "-sb", path], capture_output=True, text=True)
    try:
        return int(r.stdout.split()[0])
    except (ValueError, IndexError):
        return 0


def guards(state):
    """Keep strangers cheap: freeze (read-only) computers that aren't yours when they grow
    past the caps or the disk runs low. Returns True if a computer was frozen."""
    if time.time() - state.get("lastCheck", 0) < CHECK_SECONDS:
        return False
    state["lastCheck"] = time.time()
    others = [d for d in state["devices"] if not d.get("mine")]
    if not others:
        return False
    sizes = {d["id"]: folder_size(d["folder"]) for d in others}
    total = sum(sizes.values())
    free = shutil.disk_usage(ROOT).free
    everyone = None
    if total > OTHERS_MAX:
        everyone = f"all strangers together use {human(total)}, over the cap of {human(OTHERS_MAX)}"
    elif free < DISK_MIN_FREE:
        everyone = f"the disk has only {human(free)} free"
    froze = False
    for d in others:
        if d.get("frozen"):
            continue
        why = everyone
        if not why and sizes[d["id"]] > DEVICE_MAX:
            why = f"its folder uses {human(sizes[d['id']])}, over the cap of {human(DEVICE_MAX)}"
        if why:
            d["frozen"] = {"at": now(), "why": why}
            froze = True
            log(f"froze {d['name']} ({d['username']}): {why}. It can read but not write. "
                f"If it is yours: vlb mine {d['username']}")
    return froze


# ---- commands ---------------------------------------------------------------------

def find_device(state, key):
    for d in state["devices"]:
        if key in (d["id"], d["username"], d["folder"]):
            return d
    named = [d for d in state["devices"] if d["name"] == key]
    if len(named) == 1:
        return named[0]
    if len(named) > 1:
        sys.exit(f"{len(named)} computers are called {key!r}; use the login or folder. See: vlb status")
    return None


def device_id(key):
    """The id in a login/id, or None."""
    rid = key[2:] if key.startswith("d-") else key
    return rid if ID_RE.match(rid) else None


def last_seen(folder):
    """What the plugin last wrote to _control/status.json (after every backup and on a
    failure it could still report), or None if it never checked in."""
    try:
        with open(os.path.join(DEVICES, folder, "_control", "status.json")) as f:
            s = json.load(f)
        return s if isinstance(s, dict) else None
    except (OSError, ValueError):
        return None


def short_time(ts):
    return ts[:19] + "Z" if len(ts) > 20 else ts


def address_line(ips):
    if not ips:
        return "    address: not seen yet (it has not connected with its own login)"
    order = sorted(ips.items(), key=lambda kv: kv[1]["last"], reverse=True)
    ip, e = order[0]
    line = f"    address {ip} (since {short_time(e['first'])}, last {short_time(e['last'])}, {e['n']} requests)"
    if len(order) > 1:
        rest = ", ".join(f"{ip} (last {short_time(e['last'])[:10]})" for ip, e in order[1:4])
        line += f"\n    earlier addresses: {rest}" + (f" and {len(order) - 4} more" if len(order) > 4 else "")
    return line


def passphrase_line(folder, s):
    c = passphrase_copy(folder)
    if not c:
        return "    passphrase copy: none yet (sent at its next unlock or passphrase change)"
    line = f"    passphrase copy: kept, from {c.get('at', '?')} (vlb passphrase shows it)"
    if s and s.get("passphraseCopied") is False and s.get("at", "") > c.get("at", ""):
        line += "  NOTE: changed since; the new one arrives at the next unlock"
    return line


def health_line(s):
    if not s:
        return "    never checked in: no backup yet (Obsidian not started, or the plugin can't reach the server)"
    line = f"    last check-in {s.get('at') or '?'}, plugin {s.get('version') or '?'}"
    if s.get("lastError"):
        line += f", ERROR: {s['lastError']} (the plugin retries every minute)"
    skipped = (s.get("lastReconcile") or {}).get("skipped") or []
    if skipped:
        line += f", {len(skipped)} file(s) over 100 MB skipped"
    return line


# ---- plugin code in vlb status -------------------------------------------------------

# Why the plugin gave up on a candidate (status.json core.bad[id].why), in plain words.
BAD_WHY = {"crash": "crashed at start", "throw": "start failed", "timeout": "start timed out",
           "unlocked": "did not lock", "load": "did not load", "watchdog": "stopped backing up"}


def hours_left(at):
    """Hours until a bad mark (24 h) runs out, or None when it already has."""
    try:
        t = datetime.datetime.strptime(str(at)[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        return None
    left = (t + datetime.timedelta(hours=24) - datetime.datetime.now(datetime.timezone.utc)).total_seconds()
    return int(left // 3600) + 1 if left > 0 else None


def as_dict(v):
    return v if isinstance(v, dict) else {}


def code_lines(s):
    """What plugin code the computer runs, from the core section of its status.json."""
    if not s:
        return []
    c = s.get("core")
    if not isinstance(c, dict):
        return ["    plugin code: (plugin older than 1.7.0: no core)"]
    builtin = c.get("builtin") or "?"
    core = f"core {c.get('coreVersion', '?')}"
    bad = {k: v for k, v in as_dict(c.get("bad")).items() if isinstance(v, dict)}
    running = c.get("running")
    if running == "server":
        srv = as_dict(c.get("server"))
        forced = " FORCED" if srv.get("force") else ""
        line = f"server bundle {c.get('runningVersion') or '?'}{forced} {srv.get('state') or 'active'} ({core}); built-in {builtin}"
    elif running == "lifeboat":
        mode = "SAFE MODE, lifeboat" if c.get("safeMode") else "LIFEBOAT"
        line = f"{mode} running since {short_time(str(c.get('startedAt') or '?'))}; built-in {builtin}"
        b = bad.get(f"builtin:{builtin}")
        hours = hours_left(b.get("at")) if b and (b.get("n") or 0) >= 2 else None
        if hours:
            line += f" bad ({BAD_WHY.get(b.get('why'), b.get('why'))}, retry in {hours} h)"
    else:
        line = f"{running or '?'} {c.get('runningVersion') or builtin} ({core})"
    lines = ["    plugin code: " + line]
    problems = []
    if c.get("updateError"):
        problems.append(f"update error: {c['updateError']}")
    sick = as_dict(c.get("sick"))
    if sick:
        problems.append(f"sick: {sick.get('id')} since {short_time(str(sick.get('at') or '?'))}")
    if bad:
        # n = 1 is one crash at start: the candidate is skipped only from the second one
        problems.append("bad: " + ", ".join(f"{k} ({BAD_WHY.get(v.get('why'), v.get('why'))}{'' if (v.get('n') or 0) >= 2 else ', once'})"
                                            for k, v in bad.items()))
    if problems:
        lines.append("    plugin problems: " + "; ".join(problems))
    return lines


def slot_payload(folder, slot):
    """The payload of what is published in a slot (decoded, not verified): None when nothing
    is published, {} when the manifest cannot be read."""
    path = os.path.join(DEVICES, folder, "_control", "update", slot, "manifest.json")
    if not os.path.exists(path):
        return None
    try:
        p = json.loads(base64.b64decode(read_json(path)["payload"], validate=True))
    except (TypeError, KeyError, ValueError):
        return {}
    return p if isinstance(p, dict) else {}


def plugin_says(slot, p, s, c):
    if not s:
        return "nothing yet (never checked in)"
    if not c:
        return "nothing (a plugin older than 1.7.0 ignores it)"
    sha12, err = str(p.get("sha256") or "")[:12], c.get("updateError") or ""
    if slot == "app":
        srv = as_dict(c.get("server"))
        if srv.get("sha12") == sha12:
            words = {"staged": "staged", "waiting": "staged, activates at next lock", "active": "running it",
                     "superseded": "valid but not used: its own built-in is the same or newer",
                     "rejected": "rejected", "bad": "marked bad, back on the built-in"}.get(srv.get("state"), str(srv.get("state")))
            return words + (f" ({srv['why']})" if srv.get("why") else "")
    else:
        inst = as_dict(c.get("coreInstalled"))
        if inst.get("sha12") == sha12:
            return f"installed {inst.get('version')} (runs from the next Obsidian start)"
    for part in re.split(r"; (?=(?:app|core): )", err):
        if part.startswith(slot + ":"):
            return part
    at = str(p.get("at") or "")
    if short_time(str(s.get("at") or "")) < at:
        return f"not yet seen (last check-in {s.get('at') or '?'} is before the publish)"
    if short_time(str(c.get("lastUpdateCheck") or "")) < at:
        return "not yet seen (it checks every 10 minutes)"
    return "not taken, no error reported"


def published_lines(folder, s):
    """What vlb published into the computer's folder, and what the plugin says about it."""
    c = as_dict(s.get("core")) if s else {}
    lines = []
    for slot in ("app", "core"):
        p = slot_payload(folder, slot)
        if p is None:
            continue
        if not p:
            lines.append(f"    published: {slot} (manifest.json unreadable)")
            continue
        forced = " FORCED" if p.get("force") is True else ""
        lines.append(f"    published: {slot} {p.get('version', '?')} ({p.get('at', '?')}){forced} -> plugin says: {plugin_says(slot, p, s, c)}")
    cfg = as_dict(read_json(os.path.join(DEVICES, folder, "_control", "config.json")))
    if as_dict(cfg.get("core")).get("safeMode") is True:
        lines.append("    SAFE MODE requested in config.json (vlb safemode off ends it)")
    return lines


def lines_of(what, fn, *args):
    """fn's lines for vlb status. A computer writes its own status.json (and passphrase.json,
    config.json), a stranger's too, so they can hold anything: an odd one costs one line."""
    try:
        r = fn(*args)
    except Exception as e:
        return [f"    {what}: (not understood: {type(e).__name__})"]
    return r if isinstance(r, list) else [r]


def cmd_status(state):
    p = state["pairing"]
    if p.get("open"):
        only = f", only a computer called {p['only']!r}" if p.get("only") else ""
        print(f"Pairing: OPEN since {p.get('since')}{only}. Every computer that asks gets its own sealed folder.")
    else:
        print(f"Pairing: PAUSED since {p.get('since')}. New computers wait. Resume with: vlb open")
    waiting = len(os.listdir(INBOX)) if os.path.isdir(INBOX) else 0
    if waiting:
        print(f"Inbox: {waiting} request(s) waiting for the next run")
    for rid, m in state["moves"].items():
        print(f"Waiting for d-{rid} to pair again into data/devices/{m['folder']}")
    n = len(state["devices"])
    if not n:
        print("No paired computers.")
    else:
        print(f"Computers: {n} of {MAX_DEVICES}" + ("  FULL: new ones are refused" if n >= MAX_DEVICES else ""))
    for d in state["devices"]:
        who = "YOURS" if d.get("mine") else "stranger"
        frozen = f"  FROZEN since {d['frozen']['at']}: {d['frozen']['why']}" if d.get("frozen") else ""
        print(f"- {who}: {d['name']} (user {d['user'] or '?'}, {d['os'] or '?'})  login {d['username']}{frozen}")
        print(f"    folder data/devices/{d['folder']} ({human(folder_size(d['folder']))})  paired {d['pairedAt']}")
        print(address_line(d.get("ips") or {}))
        s = last_seen(d["folder"])
        for line in (lines_of("last check-in", health_line, s) + lines_of("plugin code", code_lines, s)
                     + lines_of("published", published_lines, d["folder"], s)
                     + lines_of("passphrase copy", passphrase_line, d["folder"], s)):
            print(line)
    if state["banned"]:
        print(f"Removed for good: {len(state['banned'])} computer(s) (vlb move lets one back in)")
    for u in state["extraUsers"]:
        print(f"- extra login {u.get('username')} -> {u.get('directory', '/data/devices')}")
    if n and not any(d.get("mine") for d in state["devices"]):
        print("No computer is marked yours yet: caps apply to all, and all are in the snapshot. "
              "Find yours above (name, user and address: on the laptop, search the web for "
              "'what is my ip' and compare) and run: vlb mine <name>")


def cmd_mine(state, key):
    d = find_device(state, key)
    if not d:
        sys.exit(f"No paired computer matches {key!r}. See: vlb status")
    was_mine = d.get("mine")
    d["mine"], d["frozen"] = True, None
    apply(state)
    log(f"{d['name']} ({d['username']}) is yours: no caps, always in the snapshot")
    if not was_mine:
        copy_mine_bundles(state, d)


def cmd_passphrase(state, key):
    d = find_device(state, key)
    if not d:
        sys.exit(f"No paired computer matches {key!r}. See: vlb status")
    c = passphrase_copy(d["folder"])
    if not c:
        sys.exit(f"No passphrase copy from {d['name']} yet; it sends one at its next unlock or passphrase change.")
    print(f"Passphrase of {d['name']} (copied {c.get('at', '?')}): {c['passphrase']}")


def cmd_move(state, key, folder):
    if not FOLDER_RE.match(folder) or not os.path.isdir(os.path.join(DEVICES, folder)):
        sys.exit(f"No folder data/devices/{folder}")
    d = find_device(state, key)
    rid = d["id"] if d else device_id(key)
    if not rid:
        sys.exit(f"No paired computer matches {key!r}. For a removed one give its login (d-...). See: vlb status")
    owner = next((o for o in state["devices"] if o["folder"] == folder), None)
    if owner and owner is not d:
        sys.exit(f"{owner['name']} ({owner['username']}) still uses that folder. "
                 f"If that computer is gone: vlb remove {owner['username']}")
    mine = bool(d and d.get("mine"))
    if d:
        state["devices"].remove(d)  # its login stops working; the plugin then asks to pair again
    if rid in state["banned"]:
        state["banned"].remove(rid)
    state["moves"][rid] = {"folder": folder, "mine": mine}
    # The folder's files go back to the computer first; otherwise its first backup would move
    # everything the computer does not have into the trash.
    cmds_path = os.path.join(DEVICES, folder, "_control", "commands.json")
    cmds = read_json(cmds_path)
    cmds = cmds if isinstance(cmds, list) else []
    cmds.append({"id": f"move-{rid}-{int(time.time())}", "cmd": "restore-all"})
    write_json(cmds_path, cmds, mode=0o644)
    apply(state)
    log(f"d-{rid} will continue data/devices/{folder}: it pairs again within a minute"
        + (f"; its folder data/devices/{d['folder']} is kept" if d and d["folder"] != folder else ""))
    if not state["pairing"].get("open"):
        print("Pairing is paused, so it waits until: vlb open")


def cmd_remove(state, key):
    d = find_device(state, key)
    if not d:
        sys.exit(f"No paired computer matches {key!r}. See: vlb status")
    state["devices"].remove(d)
    if d["id"] not in state["banned"]:
        state["banned"].append(d["id"])
    apply(state)
    log(f"removed {d['name']} ({d['username']}) for good; its folder data/devices/{d['folder']} is kept")


def cmd_open(state, only):
    state["pairing"].update({"open": True, "only": only, "since": now()})
    apply(state)
    log("pairing open" + (f", only for a computer called {only!r}" if only else ""))


def cmd_close(state):
    state["pairing"].update({"open": False, "only": None, "since": now()})
    apply(state)
    log("pairing paused by hand")


# ---- signed plugin code ---------------------------------------------------------------

def openssl(*args):
    """Run openssl and return what it printed; stop with its error message on failure."""
    try:
        r = subprocess.run(["openssl", *args], capture_output=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit(f"openssl failed: {e}")
    if r.returncode != 0:
        sys.exit(f"openssl {args[0]} failed: {r.stderr.decode(errors='replace').strip()}")
    return r.stdout


def spki_hex(key):
    """The public key of a private key file as hex SPKI DER: what the plugin's UPDATE_PUBKEYS holds."""
    h = openssl("pkey", "-in", key, "-pubout", "-outform", "DER").hex()
    if len(h) != 88 or not h.startswith(SPKI_PREFIX):
        sys.exit(f"{key} is not an Ed25519 key")
    return h


def sha256_hex(data):
    return hashlib.sha256(data).hexdigest()


def cmd_key_init():
    if os.path.exists(KEY):
        sys.exit(f"{KEY} exists; move it away by hand to rotate, then ship a release with both keys")
    os.makedirs(KEY_DIR, mode=0o700, exist_ok=True)
    tmp = KEY + ".tmp"  # becomes KEY only once everything else is written
    old = os.umask(0o077)
    try:
        openssl("genpkey", "-algorithm", "ed25519", "-out", tmp)
    finally:
        os.umask(old)
    os.chmod(tmp, 0o600)
    h = spki_hex(tmp)
    write_bytes(PUB, openssl("pkey", "-in", tmp, "-pubout"), 0o644)
    write_text(SPKI, h + "\n", 0o644)
    os.replace(tmp, KEY)
    log(f"made the signing key {KEY}; public key {h}")
    print(f"Public key (SPKI hex): {h}")
    print("Put it into UPDATE_PUBKEYS in src/shared/server.ts before tagging 1.7.0.")
    print(f"Copy {KEY} to the Mac's private folder (mode 600), never into the repo.")


def cmd_key_show():
    if not os.path.exists(KEY):
        sys.exit("No signing key yet. Make one with: vlb key init")
    h = spki_hex(KEY)
    print(f"Public key (SPKI hex): {h}")
    print(f"Fingerprint: SHA256:{sha256_hex(bytes.fromhex(h))}")
    try:
        with open(SPKI) as f:
            saved = f.read().strip()
    except OSError:
        saved = ""
    if saved != h:
        print(f"NOTE: {SPKI} does not match the key ({saved or 'missing'})")


def options(args, flags=(), values=()):
    """Option parsing by hand, like the rest of vlb: (words, options, --only list).
    Flags take no value, values take one, --only may be given more than once."""
    words, opts, only = [], {}, []
    i = 0
    while i < len(args):
        a = args[i]
        if a in flags:
            opts[a] = True
        elif a in values or a == "--only":
            if i + 1 == len(args):
                sys.exit(f"{a} needs a value. See: vlb help")
            i += 1
            if a == "--only":
                only.append(args[i])
            else:
                opts[a] = args[i]
        elif a.startswith("--"):
            sys.exit(f"Unknown option {a}. See: vlb help")
        else:
            words.append(a)
        i += 1
    return words, opts, only


def targets(state, only):
    """The computers a bundle or safemode command acts on, and how to record them: --only
    names any paired computer (yours or a stranger); without it, every computer marked yours."""
    if only:
        found = []
        for key in only:
            d = find_device(state, key)
            if not d:
                sys.exit(f"No paired computer matches {key!r}. See: vlb status")
            if d not in found:
                found.append(d)
        return found, [d["username"] for d in found]
    mine = [d for d in state["devices"] if d.get("mine")]
    if not mine:
        sys.exit("no computer is marked yours; use --only COMPUTER")
    return mine, "mine"


def version_key(v):
    """1.10.0 > 1.9.9; anything after '-' is ignored; missing parts are 0. None if not a version."""
    try:
        parts = [int(x) for x in str(v).split("-")[0].split(".")]
    except ValueError:
        return None
    return tuple(parts + [0] * (3 - len(parts)))


def next_at(state, slot):
    """now(), but always after the last publish in this slot: the plugin ignores a manifest
    that is not newer than the last one it accepted (replay guard)."""
    t, last = now(), state.get("bundleAt", {}).get(slot)
    if last and t <= last:
        try:
            t = (datetime.datetime.strptime(last, TIME_FMT) + datetime.timedelta(seconds=1)).strftime(TIME_FMT)
        except ValueError:
            pass
    return t


def sign(payload):
    """The Ed25519 signature of the payload bytes, checked with the public key before
    anything is published."""
    if not os.path.exists(KEY):
        sys.exit("No signing key yet. Make one with: vlb key init")
    tmp = tempfile.mkdtemp(prefix="vlb-sign-")
    try:
        pf, sf = os.path.join(tmp, "payload"), os.path.join(tmp, "sig")
        with open(pf, "wb") as f:
            f.write(payload)
        openssl("pkeyutl", "-sign", "-inkey", KEY, "-rawin", "-in", pf, "-out", sf)
        with open(sf, "rb") as f:
            sig = f.read()
        r = subprocess.run(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", PUB, "-rawin",
                            "-in", pf, "-sigfile", sf], capture_output=True, timeout=60)
        if r.returncode != 0 or len(sig) != 64:
            sys.exit(f"The new signature does not check out against {PUB}; nothing was published")
        return sig
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def signed_manifest(slot, version, data, force, at, note=None):
    """The signed manifest.json for a bundle: {payload, sig}."""
    p = {"v": 1, "kind": slot, "version": version, "sha256": sha256_hex(data), "size": len(data),
         "force": force, "minCore": 1, "at": at}
    if note is not None:
        p["note"] = note  # the plugin accepts a string or nothing, never null
    payload = json.dumps(p, separators=(",", ":")).encode("utf-8")
    if len(payload) > MAX_PAYLOAD:
        sys.exit(f"The signed payload would be {len(payload)} bytes, over {MAX_PAYLOAD}; shorten the note")
    return {"payload": base64.b64encode(payload).decode("ascii"),
            "sig": base64.b64encode(sign(payload)).decode("ascii")}


def slot_dir(d, slot):
    return os.path.join(DEVICES, d["folder"], "_control", "update", slot)


def put_bundle(d, slot, data, envelope):
    """Write a signed bundle into a computer's folder: the file first, then its manifest, so
    a manifest never names a file that is not there yet. 0644 like the rest of _control."""
    sdir = slot_dir(d, slot)
    write_bytes(os.path.join(sdir, SLOT_FILE[slot]), data, 0o644)
    write_json(os.path.join(sdir, "manifest.json"), envelope, 0o644)


def bundle_source(arg, name, version, unsafe_local, core):
    """(bytes, version, where) for `vlb bundle publish`: an archived version or a file."""
    archived = os.path.join(ARCHIVE, arg, name)
    if VERSION_RE.match(arg) and os.path.isfile(archived):
        if version and version != arg:
            sys.exit(f"The archive folder {arg} holds version {arg}; leave out --version")
        with open(archived, "rb") as f:
            data = f.read()
        meta = as_dict(read_json(os.path.join(ARCHIVE, arg, "meta.json")))
        # Fetched from a release, and not replaced since (a file published as this version would).
        fetched = meta.get("source") == "github" and as_dict(meta.get("sha256")).get(name) == sha256_hex(data)
        if core and not fetched and not unsafe_local:
            sys.exit(f"{archived} is not the main.js fetched from release {arg}; only a main.js fetched "
                     f"from a release is safe to publish as core (vlb bundle fetch {arg})")
        return data, arg, f"release {arg}" if fetched else f"archive {arg}"
    if not os.path.isfile(arg):
        sys.exit(f"No file {arg}, and no archived version {arg} with {name}")
    if core and not unsafe_local:
        sys.exit("only a main.js fetched from a release is safe to publish as core "
                 "(vlb bundle fetch V, then vlb bundle publish V --core); --unsafe-local overrides")
    if not version:
        sys.exit("--version V is needed when publishing a file")
    with open(arg, "rb") as f:
        data = f.read()
    return data, version, f"file {arg}"


def cmd_publish(state, args):
    words, opts, only = options(args, ("--force", "--core", "--unsafe-local"), ("--version", "--note"))
    if len(words) != 1:
        sys.exit("Usage: vlb bundle publish FILE|V [--version V] [--force] [--core] [--only COMPUTER]... "
                 "[--note TEXT] [--unsafe-local]")
    core, force, note = "--core" in opts, "--force" in opts, opts.get("--note")
    slot = "core" if core else "app"
    name = SLOT_FILE[slot]
    if core and force:
        sys.exit("--force is for app bundles only; a core bundle is never forced")
    version = opts.get("--version")
    if version is not None and not VERSION_RE.match(version):
        sys.exit(f"--version must look like 1.7.0, not {version!r}")
    devs, tgt = targets(state, only)
    data, version, where = bundle_source(words[0], name, version, "--unsafe-local" in opts, core)
    if not 0 < len(data) <= MAX_BUNDLE:
        sys.exit(f"{name} is {len(data)} bytes; it must be 1 to {MAX_BUNDLE} bytes")
    sha, at = sha256_hex(data), next_at(state, slot)
    envelope = signed_manifest(slot, version, data, force, at, note)

    # The archive keeps what was published, so it can be published again (vlb mine signs it again).
    vdir = os.path.join(ARCHIVE, version)
    meta_path = os.path.join(vdir, "meta.json")
    meta = as_dict(read_json(meta_path)) or {"version": version, "source": "file"}
    if where.startswith("file"):
        old = os.path.join(vdir, name)
        if meta.get("source") == "github" and os.path.isfile(old):
            with open(old, "rb") as f:
                if f.read() != data:
                    sys.exit(f"{old} is the file of release {version}; give this one another --version")
        write_bytes(old, data, 0o644)
    write_json(os.path.join(vdir, f"{slot}.manifest.json"), envelope, 0o644)
    meta.setdefault("published", {})[slot] = {"at": at, "sha256": sha, "force": force, "targets": tgt, "from": where}
    write_json(meta_path, meta, 0o644)

    done, failed = [], []
    for d in devs:
        try:
            put_bundle(d, slot, data, envelope)
            done.append(d["name"])
        except OSError as e:
            failed.append(f"{d['name']}: {e}")
    if done:
        # An --only publish (a test) never replaces what your computers get (vlb mine copies that).
        if tgt == "mine" or as_dict(state["bundles"].get(slot)).get("targets") != "mine":
            state["bundles"][slot] = {"version": version, "sha12": sha[:12], "force": force, "at": at, "targets": tgt}
        state.setdefault("bundleAt", {})[slot] = at
        save_state(state)
        log(f"published {slot} {version} ({sha[:12]}){' FORCED' if force else ''} from {where} to {', '.join(done)}")
    if not core and not force:
        for d in devs:
            s = last_seen(d["folder"]) or {}
            have = version_key(s.get("version"))
            if have and version_key(version) <= have:
                print(f"NOTE: {d['name']} has plugin {s['version']}; {version} is not newer, so it will "
                      f"not run there (to run it anyway, publish it again with --force)")
    if failed:
        sys.exit("Could not publish to: " + "; ".join(failed))
    print("The plugin checks within 10 minutes; " + ("it installs main.js and runs it from the next Obsidian start."
          if core else "it runs the bundle from the next lock (or start)."))


def cmd_unpublish(state, args):
    words, opts, only = options(args, ("--core",))
    if words:
        sys.exit("Usage: vlb bundle unpublish [--core] [--only COMPUTER]...")
    slot = "core" if "--core" in opts else "app"
    devs, tgt = targets(state, only)
    cleared = []
    for d in devs:
        sdir = slot_dir(d, slot)
        found = False
        for n in ("manifest.json", SLOT_FILE[slot], "manifest.json.tmp", SLOT_FILE[slot] + ".tmp"):  # the manifest first
            try:
                os.remove(os.path.join(sdir, n))
                found = True
            except FileNotFoundError:
                pass
        for empty in (sdir, os.path.dirname(sdir)):
            try:
                os.rmdir(empty)
            except OSError:
                pass
        if found:
            cleared.append(d["name"])
    if tgt == "mine":
        state["bundles"][slot] = None
        save_state(state)
    if cleared:
        log(f"unpublished the {slot} bundle from {', '.join(cleared)}")
    else:
        print(f"No {slot} bundle was published there; nothing to do")


def cmd_safemode(state, args):
    words, _, only = options(args)
    if words not in (["on"], ["off"]):
        sys.exit("Usage: vlb safemode on|off [--only COMPUTER]...")
    on = words[0] == "on"
    devs, _ = targets(state, only)
    for d in devs:
        # The app reads the same file: keep every other key as it is.
        path = os.path.join(DEVICES, d["folder"], "_control", "config.json")
        cfg = as_dict(read_json(path))
        cfg["core"] = dict(as_dict(cfg.get("core")), safeMode=on)
        write_json(path, cfg, 0o644)
    names = ", ".join(d["name"] for d in devs)
    log(f"safe mode {'on' if on else 'off'} for {names}")
    print("The plugin switches at its next check (within 10 minutes) or start.")


def copy_mine_bundles(state, d):
    """A computer newly marked yours also gets the bundles published to your computers: the
    archived file, signed again as the record says (its force, a fresh at). The archived
    manifest is not copied: any later publish of that version (an --only test too) replaces
    it, and its older at would be refused by the plugin's replay guard."""
    for slot, rec in state["bundles"].items():
        rec = as_dict(rec)
        if slot not in SLOT_FILE or rec.get("targets") != "mine":
            continue
        try:
            with open(os.path.join(ARCHIVE, str(rec.get("version")), SLOT_FILE[slot]), "rb") as f:
                data = f.read()
            if sha256_hex(data)[:12] != rec.get("sha12"):
                raise ValueError("the archived copy is not the one published")
            if not os.path.exists(KEY):
                raise ValueError("no signing key")
            at = next_at(state, slot)
            put_bundle(d, slot, data, signed_manifest(slot, rec["version"], data, rec.get("force") is True, at))
        except (OSError, ValueError, TypeError, KeyError, SystemExit) as e:  # sign() stops with sys.exit
            log(f"could not copy the {slot} bundle {rec.get('version')} to {d['name']} ({e}); publish it again")
            continue
        state.setdefault("bundleAt", {})[slot] = at
        save_state(state)
        log(f"copied the {slot} bundle {rec['version']} published to your computers to {d['name']}")


def cmd_fetch(version):
    """Download a release's files into the archive. No lock: it touches only the archive."""
    if not VERSION_RE.match(version):
        sys.exit(f"A version looks like 1.7.0, not {version!r}")
    vdir = os.path.join(ARCHIVE, version)
    os.makedirs(vdir, exist_ok=True)
    files = {"app.js": "app.js", "main.js": "main.js", "manifest.json": "release-manifest.json"}
    tmps = {}
    try:
        for src, dst in files.items():
            url, tmp = f"{RELEASES}/{version}/{src}", os.path.join(vdir, f"{dst}.{os.getpid()}.tmp")
            tmps[dst] = tmp
            try:
                r = subprocess.run(["curl", "-fsSL", "--max-time", "120", "-o", tmp, url],
                                   capture_output=True, text=True, timeout=150)
                err = (r.stderr.strip() or f"curl exit {r.returncode}") if r.returncode else ""
            except (OSError, subprocess.SubprocessError) as e:
                err = str(e)
            if err:
                hint = " (releases before 1.7.0 have no app.js)" if src == "app.js" else ""
                sys.exit(f"Could not download {url}: {err}{hint}")
        rel = read_json(tmps["release-manifest.json"])
        if not isinstance(rel, dict) or rel.get("version") != version:
            sys.exit(f"The release's manifest.json says version {as_dict(rel).get('version')!r}, not {version}")
        sums = {}
        for n in ("app.js", "main.js"):
            size = os.path.getsize(tmps[n])
            if not 0 < size <= MAX_BUNDLE:
                sys.exit(f"{n} of release {version} is {size} bytes; it must be 1 to {MAX_BUNDLE} bytes")
            with open(tmps[n], "rb") as f:
                sums[n] = sha256_hex(f.read())
        for dst, tmp in tmps.items():
            os.replace(tmp, os.path.join(vdir, dst))
    finally:
        for tmp in tmps.values():
            if os.path.exists(tmp):
                os.remove(tmp)
    meta_path = os.path.join(vdir, "meta.json")
    meta = as_dict(read_json(meta_path))
    meta.update({"version": version, "source": "github", "fetchedAt": now(), "sha256": sums})
    write_json(meta_path, meta, 0o644)
    log(f"fetched release {version} into {vdir}: app.js {sums['app.js'][:12]}, main.js {sums['main.js'][:12]}")
    print(f"Publish with: vlb bundle publish {version}   (or --core for main.js)")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, args = argv[0], argv[1:]
    os.makedirs(ROOT, exist_ok=True)
    if cmd == "bundle" and args[:1] == ["fetch"]:
        if len(args) != 2:
            sys.exit("Usage: vlb bundle fetch V")
        return cmd_fetch(args[1])  # downloads can take minutes: never hold the lock for them
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_state()
        if cmd == "status" and not args:
            cmd_status(state)
        elif cmd == "mine" and len(args) == 1:
            cmd_mine(state, args[0])
        elif cmd == "passphrase" and len(args) == 1:
            cmd_passphrase(state, args[0])
        elif cmd == "move" and len(args) == 2:
            cmd_move(state, args[0], args[1])
        elif cmd == "remove" and len(args) == 1:
            cmd_remove(state, args[0])
        elif cmd == "open" and (not args or (args[0] == "--only" and len(args) == 2 and clean(args[1]))):
            cmd_open(state, clean(args[1]) if args else None)
        elif cmd == "close" and not args:
            cmd_close(state)
        elif cmd == "process" and not args:
            process(state)
        elif cmd == "apply" and args in ([], ["--no-restart"]):
            apply(state, restart=not args)
        elif cmd == "key" and args == ["init"]:
            cmd_key_init()
        elif cmd == "key" and args == ["show"]:
            cmd_key_show()
        elif cmd == "bundle" and args[:1] == ["publish"]:
            cmd_publish(state, args[1:])
        elif cmd == "bundle" and args[:1] == ["unpublish"]:
            cmd_unpublish(state, args[1:])
        elif cmd == "safemode":
            cmd_safemode(state, args)
        else:
            sys.exit(f"Unknown command: {' '.join(argv)}. See: vlb help")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except SystemExit:
        raise
    except Exception as e:  # keep the timer's log readable
        log(f"ERROR {type(e).__name__}: {e}")
        sys.exit(1)
